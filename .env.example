# Path to the SQLite database file (relative to project root or absolute)
DATABASE_PATH=./rfpsquad.db

# Global admin password for the /admin panel
ADMIN_PASSWORD=changeme

# Public URL of your deployment (used by adapter-node and OAuth callbacks)
ORIGIN=https://yourdomain.com

# Facebook OAuth (optional — leave blank to disable Facebook login)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
